// 이 파일을 `Secrets.swift` 로 복사하고 키를 채운다. `Secrets.swift` 는 gitignore 대상이다.
import Foundation

enum Secrets {
    static let anthropicAPIKey = "sk-ant-..."
    /// 주문 백엔드(`backend/`) 주소. 시뮬레이터는 localhost, 실기기는 같은 네트워크의 개발 머신 주소를 쓴다.
    static let backendURL = URL(string: "http://localhost:8787")!
    /// Stripe publishable key (테스트 모드). 비밀 키(`sk_test_…`)는 백엔드 환경변수에만 둔다.
    static let stripePublishableKey = "pk_test_..."
}
