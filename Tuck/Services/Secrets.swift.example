// Copy this file to `Secrets.swift` and add your keys. `Secrets.swift` is ignored by git.
import Foundation

enum Secrets {
    static let anthropicAPIKey = "sk-ant-..."
    /// Order backend (`backend/`) URL. Use localhost in Simulator and the development machine's LAN address on a physical device.
    static let backendURL = URL(string: "http://localhost:8787")!
    /// Stripe publishable key (test mode). Keep the secret key (`sk_test_…`) in backend environment variables only.
    static let stripePublishableKey = "pk_test_..."
}
